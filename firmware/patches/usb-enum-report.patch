+#include "usb/usb_host.h"     /* My UPS Pal patch (usb-enum-report.patch) */
 #include "usb/usb_types_stack.h"
 #include "usb/usb_types_ch9.h"
 
@@ -172,6 +173,13 @@
  */
 esp_err_t enum_process(void);
 
+/* My UPS Pal patch (firmware/patches/usb-enum-report.patch): hub.c reports
+ * root port connections and failures before enumeration starts. */
+void enum_report_connect(void);
+void enum_report_fail(uint8_t stage, int8_t status, uint16_t got, uint16_t want);
+void enum_report_get(usb_host_enum_report_t *out);
+const char *enum_report_stage_name(uint8_t stage);
+
 #ifdef __cplusplus
 }
 #endif
diff -ruN a/usb/usb_host.c b/usb/usb_host.c
--- a/usb/usb_host.c
+++ b/usb/usb_host.c
@@ -1677,3 +1677,14 @@
 {
     return hcd_stray_chan_events();
 }
+
+/* My UPS Pal patch (firmware/patches/usb-enum-report.patch). */
+void usb_host_enum_report(usb_host_enum_report_t *out)
+{
+    enum_report_get(out);
+}
+
+const char *usb_host_enum_stage_name(uint8_t stage)
+{
+    return enum_report_stage_name(stage);
+}
