+++ b/usb/hub.c
@@ -17,6 +17,7 @@
 #include "usb_private.h"
 #include "hcd.h"
 #include "hub.h"
+#include "enum.h"     /* My UPS Pal patch (usb-enum-report.patch) */
 #include "usb/usb_helpers.h"
 
 #if ENABLE_USB_HUBS
@@ -383,18 +384,22 @@
         // Nothing to do
         break;
     case HCD_PORT_EVENT_CONNECTION: {
+        enum_report_connect();      /* My UPS Pal patch (usb-enum-report.patch) */
         if (hcd_port_command(root_port_hdl, HCD_PORT_CMD_RESET) != ESP_OK) {
             ESP_LOGE(HUB_DRIVER_TAG, "Root port reset failed");
