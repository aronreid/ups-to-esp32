diff -ruN a/usb/enum.c b/usb/enum.c
--- a/usb/enum.c
+++ b/usb/enum.c
@@ -117,6 +117,54 @@
     "CANCEL",
 };
 
+/* My UPS Pal patch (firmware/patches/usb-enum-report.patch). ESP-IDF cancels
+ * a failed enumeration quietly: no client hears of the device at all, so a
+ * UPS that fails here looks exactly like one that is not plugged in. Keep the
+ * last failure for the board's diagnostics. Written from the USB host
+ * library task only; read anywhere under the spinlock. */
+static portMUX_TYPE s_enum_report_mux = portMUX_INITIALIZER_UNLOCKED;
+static usb_host_enum_report_t s_enum_report = { .status = -1 };
+
+void enum_report_connect(void)
+{
+    portENTER_CRITICAL(&s_enum_report_mux);
+    s_enum_report.connects++;
+    portEXIT_CRITICAL(&s_enum_report_mux);
+}
+
+void enum_report_fail(uint8_t stage, int8_t status, uint16_t got, uint16_t want)
+{
+    portENTER_CRITICAL(&s_enum_report_mux);
+    s_enum_report.fails++;
+    s_enum_report.stage = stage;
+    s_enum_report.status = status;
+    s_enum_report.got = got;
+    s_enum_report.want = want;
+    portEXIT_CRITICAL(&s_enum_report_mux);
+}
+
+void enum_report_get(usb_host_enum_report_t *out)
+{
+    portENTER_CRITICAL(&s_enum_report_mux);
+    *out = s_enum_report;
+    portEXIT_CRITICAL(&s_enum_report_mux);
+}
+
+const char *enum_report_stage_name(uint8_t stage)
+{
+    switch (stage) {
+    case USB_HOST_ENUM_FAIL_PORT_RESET: return "PORT_RESET";
+    case USB_HOST_ENUM_FAIL_PORT_SPEED: return "PORT_SPEED";
+    case USB_HOST_ENUM_FAIL_NEW_DEV:    return "NEW_DEV";
+    case USB_HOST_ENUM_FAIL_CANCELLED:  return "CANCELLED";
+    default: break;
+    }
+    if (stage < sizeof(enum_stage_strings) / sizeof(enum_stage_strings[0])) {
+        return enum_stage_strings[stage];
+    }
+    return "?";
+}
+
 typedef struct {
     // Constant
     uint8_t new_dev_addr;           /**< Device address that should be assigned during enumeration */
@@ -1072,6 +1120,13 @@
                          p_enum_driver->single_thread.parent_dev_addr,
                          p_enum_driver->single_thread.parent_port_num,
                          enum_stage_strings[last_stage]);
+                /* My UPS Pal patch (usb-enum-report.patch). */
+                {
+                    const usb_transfer_t *x = &p_enum_driver->constant.urb->transfer;
+                    int exp = p_enum_driver->single_thread.expect_num_bytes;
+                    enum_report_fail((uint8_t)last_stage, (int8_t)x->status,
+                                     (uint16_t)x->actual_num_bytes, (uint16_t)(exp > 0 ? exp : 0));
+                }
                 next_stage = ENUM_STAGE_CANCEL;
                 break;
             }
@@ -1288,6 +1343,8 @@
     }
 
     p_enum_driver->single_thread.stage = ENUM_STAGE_CANCEL;
+    /* My UPS Pal patch (usb-enum-report.patch): the device left mid-way. */
+    enum_report_fail(USB_HOST_ENUM_FAIL_CANCELLED, -1, 0, (uint16_t)old_stage);
 
     ESP_LOGV(ENUM_TAG, "[%d:%d] Cancel at %s",
              p_enum_driver->single_thread.parent_dev_addr,
diff -ruN a/usb/hub.c b/usb/hub.c
