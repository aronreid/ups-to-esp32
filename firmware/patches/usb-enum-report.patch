diff -ruN a/usb/include/usb/usb_host.h b/usb/include/usb/usb_host.h
--- a/usb/include/usb/usb_host.h
+++ b/usb/include/usb/usb_host.h
@@ -681,7 +681,35 @@
  * @return Count since boot
  */
 uint32_t usb_host_stray_chan_events(void);
+
+/**
+ * @brief What the root port and enumeration did, for diagnostics
+ *
+ * My UPS Pal patch (firmware/patches/usb-enum-report.patch); not in ESP-IDF.
+ * ESP-IDF gives up on a device that fails enumeration without telling any
+ * client: the device simply never appears. This records it.
+ */
+typedef struct {
+    uint32_t connects;      /**< Root port connections seen since boot */
+    uint32_t fails;         /**< Enumerations that failed since boot */
+    uint8_t  stage;         /**< Last failure: enumeration stage, or one of USB_HOST_ENUM_FAIL_* */
+    int8_t   status;        /**< Last failure: usb_transfer_status_t of the stage's transfer, -1 none */
+    uint16_t got;           /**< Last failure: bytes the device returned (setup packet included) */
+    uint16_t want;          /**< Last failure: bytes expected, 0 if any */
+} usb_host_enum_report_t;
 
+#define USB_HOST_ENUM_FAIL_PORT_RESET   0xF0    /**< root port reset failed after a connection */
+#define USB_HOST_ENUM_FAIL_PORT_SPEED   0xF1    /**< could not read the port speed after reset */
+#define USB_HOST_ENUM_FAIL_NEW_DEV      0xF2    /**< could not add the device */
+#define USB_HOST_ENUM_FAIL_CANCELLED    0xF3    /**< enumeration cancelled from outside (device left) */
+
+void usb_host_enum_report(usb_host_enum_report_t *out);
+
+/**
+ * @brief Name of an enumeration stage or USB_HOST_ENUM_FAIL_* code, for logs
+ */
+const char *usb_host_enum_stage_name(uint8_t stage);
+
 #ifdef __cplusplus
 }
 #endif
