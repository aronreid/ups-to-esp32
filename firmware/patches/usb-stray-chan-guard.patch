+/**
+ * @brief How many stray channel interrupts the host controller driver has ignored
+ *
+ * My UPS Pal patch (firmware/patches/usb-stray-chan-guard.patch); not in ESP-IDF.
+ * A channel interrupt that arrives while no transfer is executing on its pipe
+ * would corrupt the pipe's buffer counters (and trip an assert in the ISR);
+ * the driver ignores it and counts it here.
+ *
+ * @return Count since boot
+ */
+uint32_t usb_host_stray_chan_events(void);
+
 #ifdef __cplusplus
 }
 #endif
