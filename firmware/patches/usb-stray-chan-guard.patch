+    /* My UPS Pal patch (firmware/patches/usb-stray-chan-guard.patch).
+     * Every legitimate channel event ends the buffer that is executing. One
+     * that arrives with no buffer executing is stray: it can come late, after
+     * the port went down and a flush had already retired that buffer. Marking
+     * a buffer done anyway retires one that holds no URB: _buffer_parse()
+     * then trips assert(buffer_to_parse->urb != NULL) in this ISR (or
+     * _buffer_exec() its own), and buffer_num_to_exec wraps below zero in its
+     * 2-bit field. Either way the board restarts. A stray event is counted
+     * and ignored instead, so the counters stay in 0..2 and every buffer
+     * parsed holds a URB. A halt request is still answered, as the task
+     * waiting for it would otherwise wait for ever. */
+    if (!pipe->multi_buffer_control.buffer_is_executing && chan_event != USB_DWC_HAL_CHAN_EVENT_NONE) {
+        s_stray_chan_events++;
+        if (chan_event == USB_DWC_HAL_CHAN_EVENT_HALT_REQ && pipe->task_waiting_pipe_notif != NULL) {
+            pipe->state = HCD_PIPE_STATE_HALTED;
+            *yield |= _internal_pipe_event_notify(pipe, true);
+        }
+        return HCD_PIPE_EVENT_NONE;
+    }
 
