lwIP upstream d08f4773e (2026-09-01) + 3d1c9bff5 (2026-11-22), bug #68610,
on ESP-IDF 5.5.6's lwIP.
An ICMPv6 Packet Too Big with an MTU below IPv6's minimum of 1280 is
dropped, and nd6_get_destination_mtu() never returns less than 1280. Before,
one forged PTB with an MTU of 48-55 made ip6_frag() loop for ever on the
tcpip thread for any IPv6 packet sent to that destination.

diff -ruN a/lwip/lwip/src/core/ipv6/nd6.c b/lwip/lwip/src/core/ipv6/nd6.c
--- a/lwip/lwip/src/core/ipv6/nd6.c	2026-11-25 13:55:58
+++ b/lwip/lwip/src/core/ipv6/nd6.c	2026-11-25 13:55:58
@@ -1041,8 +1041,13 @@
       return;
     }
 
-    /* Change the Path MTU. */
     pmtu = lwip_htonl(icmp6hdr->data);
+    if (pmtu < IP6_MIN_MTU_LENGTH) {
+      /* MTU too small */
+      pbuf_free(p);
+      return;
+    }
+    /* Change the Path MTU. */
     destination_cache[dest_idx].pmtu = (u16_t)LWIP_MIN(pmtu, 0xFFFF);
 
     break; /* ICMP6_TYPE_PTB */
@@ -2268,7 +2273,7 @@
 #ifdef LWIP_HOOK_ND6_GET_GW
       } else if ((next_hop_addr = LWIP_HOOK_ND6_GET_GW(netif, ip6addr)) != NULL) {
         /* Next hop for destination provided by hook function. */
-        dest->pmtu = netif->mtu;
+        dest->pmtu = netif_mtu6(netif);
         ip6_addr_set(&dest->next_hop_addr, next_hop_addr);
 #endif /* LWIP_HOOK_ND6_GET_GW */
       } else {
@@ -2710,12 +2715,14 @@
   i = nd6_find_destination_cache_entry(ip6addr);
   if (i >= 0) {
     if (destination_cache[i].pmtu > 0) {
-      return destination_cache[i].pmtu;
+      /* MTU must be at least 1280 */
+      return LWIP_MAX(IP6_MIN_MTU_LENGTH, destination_cache[i].pmtu);
     }
   }
 
   if (netif != NULL) {
-    return netif_mtu6(netif);
+    /* MTU must be at least 1280 */
+    return LWIP_MAX(IP6_MIN_MTU_LENGTH, netif_mtu6(netif));
   }
 
   return IP6_MIN_MTU_LENGTH; /* Minimum MTU */
