 }
 
+/* My UPS Pal patch (firmware/patches/usb-ep0-abort.patch): abandon the
+ * control transfers in flight on a device's EP0, the way usbh already does
+ * itself after an EP0 error: halt the pipe, retire its URBs (status
+ * CANCELED), hand each back to its owner's callback, and make the pipe active
+ * again so a fresh SETUP can go out. ESP-IDF 5.5 has no public way to do this;
+ * a device that never answers one control request otherwise holds EP0 until
+ * it is unplugged. */
+esp_err_t usbh_dev_ep0_abort(usb_device_handle_t dev_hdl)
+{
+    USBH_CHECK(dev_hdl != NULL, ESP_ERR_INVALID_ARG);
+    device_t *dev_obj = (device_t *)dev_hdl;
+    esp_err_t ret;
+    bool call_proc_req_cb = false;
+
+    USBH_ENTER_CRITICAL();
+    if (dev_obj->dynamic.flags.is_gone) {
+        ret = ESP_ERR_INVALID_STATE;        /* the gone path flushes EP0 itself */
+    } else if (dev_obj->dynamic.num_ctrl_xfers_inflight == 0) {
+        ret = ESP_ERR_NOT_FOUND;            /* nothing to abandon */
+    } else {
+        call_proc_req_cb = _dev_set_actions(dev_obj,
+                                            DEV_ACTION_EP0_FLUSH |
+                                            DEV_ACTION_EP0_DEQUEUE |
+                                            DEV_ACTION_EP0_CLEAR);
+        ret = ESP_OK;
+    }
+    USBH_EXIT_CRITICAL();
+
+    if (call_proc_req_cb) {
+        p_usbh_obj->constant.proc_req_cb(USB_PROC_REQ_SOURCE_USBH, false, p_usbh_obj->constant.proc_req_cb_arg);
+    }
+    return ret;
+}
