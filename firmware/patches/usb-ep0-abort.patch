+/**
+ * @brief Abandon the control transfers in flight to a device
+ *
+ * My UPS Pal patch (firmware/patches/usb-ep0-abort.patch); not in ESP-IDF.
+ * EP0 is halted and flushed, each transfer in flight is returned through its
+ * callback (from usb_host_client_handle_events(), as usual) with status
+ * USB_TRANSFER_STATUS_CANCELED, and EP0 is made active again, so the next
+ * control transfer sends a fresh SETUP. Asynchronous: wait for the callback
+ * before freeing or reusing the transfer.
+ *
+ * @return
+ *    - ESP_OK: abort queued
+ *    - ESP_ERR_INVALID_ARG: Invalid argument
+ *    - ESP_ERR_NOT_FOUND: no control transfer in flight
+ *    - ESP_ERR_INVALID_STATE: the device is gone (its transfers return by themselves)
+ */
+esp_err_t usb_host_transfer_abort_control(usb_host_client_handle_t client_hdl, usb_device_handle_t dev_hdl);
