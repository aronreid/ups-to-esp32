# SPDX-License-Identifier: GPL-3.0-or-later
# Shared defaults for every target; Rev A as-is. Rev B layers
# sdkconfig.defaults.revb on top. Board choice lives in menuconfig
# (ups-adaptor board), not here, so one tree builds both.

CONFIG_IDF_TARGET="esp32s3"

# Rev A: 4MB flash, dual OTA. N4 has no PSRAM -- do not enable SPIRAM here;
# Rev B turns it on in sdkconfig.defaults.revb.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The S3's single USB PHY is dedicated to the USB-A host port, so the console
# stays on UART0 via the CH340C -- never USB-Serial-JTAG. The usb_host
# component needs no Kconfig switch; depending on it in CMakeLists is enough.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# No Bluetooth. Setup is a browser on the provisioning SoftAP; BLE provisioning
# would require a phone app, which is the thing this device deliberately avoids.
# Explicit rather than relying on the default, so the controller's flash and
# ~30KB of SRAM stay reclaimed if anything later pulls in a BT dependency.
CONFIG_BT_ENABLED=n

# A closet device must reboot itself rather than hang.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_INT_WDT=y

# Web UI needs a few concurrent sockets alongside NUT clients.
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- OTA from GitHub releases -----------------------------------------------
# Rollback is what makes an unattended update safe: a new image boots on trial
# and the bootloader reverts unless it confirms itself. A device behind a UPS in
# a closet cannot be recovered with a cable.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# GitHub is HTTPS and redirects release assets to a second host, so the roots
# have to come from somewhere. The bundle costs flash and avoids pinning a
# certificate that expires.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# The TLS handshake needs a bigger stack than the default HTTP client task.
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=n

# --- Memory -----------------------------------------------------------------
# The update check is the board's deepest dip: a TLS handshake to GitHub plus
# the release response took internal heap from 203 KB to 132 KB (v0.08,
# measured). mbedTLS otherwise holds a fixed 16 KB receive and 4 KB send record
# buffer for the life of every connection; dynamic buffers size them to what
# is in flight, and the handshake's configuration and CA data are freed as
# soon as it completes. The fleet heartbeat is TLS too, and shares a gate
# with the update check (ota_tls_take) so the two never overlap.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
# Task stacks, trimmed from measured deepest use (memdiag, v0.08, a UPS
# attached, the page and /metrics under load), each keeping over 1 KB spare.
CONFIG_ESP_TIMER_TASK_STACK_SIZE=2560
CONFIG_MDNS_TASK_STACK_SIZE=3584

# --- Fleet heartbeat (components/fleet) -------------------------------------
# The project's Supabase URL and its PUBLIC publishable key. Both are meant to
# be public; the key can only call heartbeat() (telemetry/supabase.sql).
CONFIG_UPSA_FLEET_URL="https://gffauvhiqmpzkldtmfqn.supabase.co"
CONFIG_UPSA_FLEET_KEY="sb_publishable_uOtmJ4x81-MDidqRUpT1AA_b9ev9fR0"

# Wi-Fi IRAM speed options off: they pin 10+ KB of Wi-Fi code in IRAM, which
# on the S3 comes out of the same pool as internal data RAM. Throughput drops
# a little; a UPS monitor moves a few hundred bytes every few seconds.
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_ESP_WIFI_EXTRA_IRAM_OPT is not set

# Rev A has no PSRAM, so the 32 KB data cache only holds internal RAM that
# is never cached; 16 KB hands 16 KB back to the heap. Rev B overrides this.
CONFIG_ESP32S3_DATA_CACHE_16KB=y

# Non-ISR FreeRTOS, heap and ringbuffer code runs from flash instead of IRAM.
# Checked: the only IRAM_ATTR in firmware/components is the crash-log panic
# wrapper, which calls none of them.
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y

# The peer certificate is not kept after the handshake; nothing in
# firmware/components or main reads it (no mbedtls_ssl_get_peer_cert, no
# esp_tls peer-cert calls), and the CA bundle verifies during the handshake.
# CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE is not set
